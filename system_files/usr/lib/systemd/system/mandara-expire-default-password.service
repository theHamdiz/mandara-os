# The ready-made disks (disk_config/disk.toml) ship a "mandara" account whose
# password is public, so it expires on the first boot: the first login asks
# for a new one (Mandara Login shows PAM's change-password prompts). Runs once.
[Unit]
Description=Ask the default account for a new password at its first login
ConditionPathExists=!/var/lib/mandara-os/default-password-expired
After=systemd-sysusers.service
Before=greetd.service systemd-user-sessions.service

[Service]
Type=oneshot
# If the expiry fails, lock the account instead of leaving the public password.
ExecStart=/usr/bin/sh -c 'if id -u mandara >/dev/null 2>&1; then chage -d 0 mandara || usermod -L mandara; fi'
ExecStart=/usr/bin/mkdir -p /var/lib/mandara-os
ExecStart=/usr/bin/touch /var/lib/mandara-os/default-password-expired

[Install]
WantedBy=multi-user.target
