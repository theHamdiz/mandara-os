# Repairs disks that booted the first 0.28.0 image, which expired the public
# `mandara` password on first boot: Fedora's greetd (0.10.3) can't change an
# expired password, so the login screen refused it. Runs once, before the
# login screen, and only touches the account while its password is still in
# that forced-change state (0 in /etc/shadow's last-change field), so a
# password someone already changed is left alone.
[Unit]
Description=Clear the forced password change on the default account
ConditionPathExists=!/var/lib/mandara-os/default-password-unexpired
After=systemd-sysusers.service
Before=greetd.service systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/mandara-os/unexpire-default-password
ExecStart=/usr/bin/mkdir -p /var/lib/mandara-os
ExecStart=/usr/bin/touch /var/lib/mandara-os/default-password-unexpired

[Install]
WantedBy=multi-user.target
