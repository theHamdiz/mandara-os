#!/usr/bin/sh
# Clears the forced password change the first 0.28.0 image put on the ready-
# made disks' `mandara` account (see mandara-unexpire-default-password.service).
# Only while the last-change field in /etc/shadow is still 0: a password
# someone already changed is left alone.
set -eu
if awk -F: '$1 == "mandara" && $3 == "0" { found = 1 } END { exit !found }' /etc/shadow; then
	chage -d "$(date +%F)" mandara
fi
