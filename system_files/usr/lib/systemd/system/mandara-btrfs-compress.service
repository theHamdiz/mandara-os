# Transparent zstd:1 compression for the whole Btrfs root (compression is a
# file-system-wide mount option, so one remount covers /sysroot, /var and
# /home). Skipped on other file systems.
[Unit]
Description=Enable zstd:1 compression on the Btrfs root
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target
ConditionPathIsMountPoint=/sysroot

[Service]
Type=oneshot
ExecStart=/usr/bin/sh -c 'if [ "$(findmnt -n -o FSTYPE /sysroot)" = btrfs ]; then mount -o remount,compress=zstd:1 /sysroot; fi'
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
